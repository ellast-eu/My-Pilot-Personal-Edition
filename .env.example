# Copier en .env puis compléter. Ce fichier ne doit jamais être versionné.
# Les mots de passe, jetons et rythmes de sauvegarde peuvent aussi se saisir dans l'application
# (Données → Réglages du serveur) : la valeur saisie là-bas l'emporte sur celle d'ici.

# --- Accès ---
PORT=8080
BIND_ADDR=127.0.0.1          # 0.0.0.0 seulement derrière un pare-feu ou un VPN
APP_USER=pilot
APP_PASSWORD=                # vide = aucune authentification (acceptable en local uniquement)

# --- Exposition sur Internet avec Caddy (docker compose --profile caddy up -d) ---
# Profils lancés par un simple « docker compose up -d » (et par le service systemd) : caddy, replication
COMPOSE_PROFILES=
PILOT_DOMAIN=                # ex. pilot.ellast.eu (enregistrement DNS A/AAAA vers ce serveur)
TRUST_PROXY=0                # 1 avec Caddy : adresse réelle des visiteurs ; le serveur refuse alors de démarrer sans APP_PASSWORD

# --- Veilles (flux RSS) ---
VEILLES_RESEAU_LOCAL=0       # 1 pour autoriser des flux sur le réseau local (ex. un RSS-Bridge chez vous)
FRANCETRAVAIL_CLIENT_ID=     # offres d'emploi : accès gratuit sur francetravail.io (API « Offres d'emploi v2 »)
FRANCETRAVAIL_CLIENT_SECRET= # (ou à saisir dans Données → Réglages)

# --- Synchronisation des applications de bureau ---
SYNC_TOKEN=                  # jeton long et aléatoire (ex. : openssl rand -hex 32), à saisir dans chaque application

# --- Claude Code (abonnement claude.ai Pro ou Max) ---
INSTALL_CLAUDE=true
# Jeton obtenu en lançant « claude setup-token » sur un ordinateur où Claude Code est connecté
# à votre compte claude.ai (pas forcément ce serveur). Inutile pour l'application de bureau.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BRIDGE=on             # off pour désactiver le pont

# --- Historique et instantanés locaux ---
REVISION_INTERVAL=300        # une version au plus toutes les 5 min pendant la saisie
KEEP_REVISIONS=300
SNAPSHOT_HOURS=24            # copie complète de la base, dans le volume, chaque jour
KEEP_SNAPSHOTS=30

# --- Réplication distante S3 (deploy/litestream.s3.yml) ---
LITESTREAM_BUCKET=
LITESTREAM_PATH=my-pilot-personal-edition
LITESTREAM_ENDPOINT=         # ex. https://s3.fr-par.scw.cloud ; vide pour AWS
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Réplication distante SFTP (deploy/litestream.sftp.yml) ---
SFTP_HOST=                   # hote:22
SFTP_USER=
SFTP_PATH=
SFTP_HOST_KEY=               # sortie de : ssh-keyscan -t ed25519 hote
