# HTTPS public devant My Pilot Personal Edition (certificat Let's Encrypt obtenu et renouvelé seul).
# Lancement : PILOT_DOMAIN et TRUST_PROXY=1 dans .env, puis docker compose --profile caddy up -d
#
# Pas d'authentification ici : c'est l'application qui la fait (page de connexion de l'interface,
# jeton de synchronisation, jetons des membres des espaces). Un « basic_auth » Caddy
# intercepterait l'en-tête Authorization et casserait la synchronisation.
# Caddy transmet X-Forwarded-Proto : le cookie de session est alors marqué Secure.
{$PILOT_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Caddy remplace l'en-tête X-Forwarded-For par l'adresse réelle du visiteur :
	# l'application la lit (TRUST_PROXY=1) pour freiner les essais de mots de passe.
	reverse_proxy app:8080
}
