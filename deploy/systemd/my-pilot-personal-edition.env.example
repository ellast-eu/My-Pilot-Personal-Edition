# Configuration du service systemd sans Docker (/etc/my-pilot-personal-edition.env, droits 600).
# Format systemd : une variable par ligne, PAS de commentaire en fin de ligne.
# Les mots de passe et jetons peuvent aussi se saisir dans l'application (Données → Réglages du serveur).

# Écoute : 127.0.0.1 derrière un proxy HTTPS sur la même machine (Caddy, Nginx…)
HOST=127.0.0.1
PORT=8080

# Accès à l'interface web (page de connexion)
APP_USER=pilot
APP_PASSWORD=

# Jeton de synchronisation des applications de bureau (openssl rand -hex 32)
SYNC_TOKEN=

# 1 derrière un proxy HTTPS : adresse réelle des visiteurs, cookie Secure, mot de passe obligatoire
TRUST_PROXY=1

# Claude Code (abonnement claude.ai) : jeton obtenu avec « claude setup-token »
CLAUDE_CODE_OAUTH_TOKEN=

# Sauvegardes
SNAPSHOT_HOURS=24
KEEP_SNAPSHOTS=30
