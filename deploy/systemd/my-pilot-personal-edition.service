# My Pilot Personal Edition — démarrage automatique de la pile Docker Compose au boot.
#
# Installation (le dépôt dans /opt/my-pilot-personal-edition, .env complété) :
#   sudo cp deploy/systemd/my-pilot-personal-edition.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now my-pilot-personal-edition
#
# Profils (caddy, replication) : COMPOSE_PROFILES dans .env, par exemple COMPOSE_PROFILES=caddy
# Autre emplacement du dépôt : sudo systemctl edit my-pilot-personal-edition
#   [Service]
#   WorkingDirectory=/chemin/vers/my-pilot-personal-edition

[Unit]
Description=My Pilot Personal Edition (Docker Compose)
Documentation=https://github.com/Numidara/My-Pilot-Personal-Edition
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/my-pilot-personal-edition
# Le .env est lu par docker compose lui-même (pas par systemd) : ses commentaires en fin de ligne restent valables.
ExecStartPre=/usr/bin/test -f .env
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
# La première construction de l'image (Claude Code compris) peut être longue.
TimeoutStartSec=15min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
